<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Quartermaster.Gui.Localization"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Onboarding" x:Class="Quartermaster.Gui.Onboarding.TourView"
             x:DataType="vm:OnboardingCoordinator" Width="360">
  <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="20">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Progress}" Classes="accent" FontSize="11" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <Button Content="{loc:Loc 'Skip tour'}" Command="{Binding SkipCommand}" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Content="{loc:Loc 'Back'}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
        <Button Grid.Column="2" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Classes="primary" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
