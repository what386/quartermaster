<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Onboarding" x:Class="Quartermaster.Gui.Onboarding.SetupDialog"
             x:DataType="vm:SetupViewModel" Width="480">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Progress}" Classes="accent" FontSize="11" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Title}" Classes="pageTitle" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
    <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left" IsVisible="{Binding IsGame}">
        <shared:ContentSizedTextBox x:Name="GameFolderInput" Text="{Binding GamePath, Mode=TwoWay}" PlaceholderText="Helldivers 2 folder" />
        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" />
      </Grid>
      <CheckBox IsVisible="{Binding IsUpdates}" Content="Allow automatic update checks" IsChecked="{Binding AllowAutomaticUpdate, Mode=TwoWay}" />
      <StackPanel IsVisible="{Binding IsNexus}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
          <shared:ContentSizedTextBox x:Name="NexusKeyInput" Text="{Binding NexusApiKey, Mode=TwoWay}" PasswordChar="*" IsEnabled="{Binding !RemoveNexusKey}" PlaceholderText="Personal Nexus API key" />
          <Button Grid.Column="1" x:Name="RemoveNexusKeyButton" Content="{Binding RemoveNexusKeyLabel}" Command="{Binding RemoveNexusKeyCommand}" IsVisible="{Binding HasSavedNexusKey}" ToolTip.Tip="Continue to apply removal." />
        </Grid>
        <HyperlinkButton Content="Get your Nexus API key →" Command="{Binding OpenNexusCommand}" Foreground="{DynamicResource AccentBrush}" Padding="0" />
      </StackPanel>
      <StackPanel IsVisible="{Binding IsGitHub}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
          <shared:ContentSizedTextBox x:Name="GitHubTokenInput" Text="{Binding GitHubToken, Mode=TwoWay}" PasswordChar="*" IsEnabled="{Binding !RemoveGitHubToken}" PlaceholderText="GitHub personal access token" />
          <Button Grid.Column="1" x:Name="RemoveGitHubTokenButton" Content="{Binding RemoveGitHubTokenLabel}" Command="{Binding RemoveGitHubTokenCommand}" IsVisible="{Binding HasSavedGitHubToken}" ToolTip.Tip="Continue to apply removal." />
        </Grid>
        <HyperlinkButton Content="Create a GitHub token →" Command="{Binding OpenGitHubCommand}" Foreground="{DynamicResource AccentBrush}" Padding="0" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left" IsVisible="{Binding IsDownloads}">
        <shared:ContentSizedTextBox Text="{Binding DownloadFolder, Mode=TwoWay}" PlaceholderText="Browser download folder" />
        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" />
      </Grid>
    </StackPanel>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    <TextBlock Text="Saving…" IsVisible="{Binding IsBusy}" Classes="muted" FontSize="11" />
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <Button x:Name="SkipSetupButton" Content="Skip setup" Command="{Binding SkipSetupCommand}" IsVisible="{Binding CanSkipSetup}" HorizontalAlignment="Left" />
      <Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
      <Button x:Name="SkipStepButton" Grid.Column="2" Content="{Binding SkipLabel}" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkipStep}" />
      <Button Grid.Column="3" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Classes="primary" />
    </Grid>
  </StackPanel>
</UserControl>
