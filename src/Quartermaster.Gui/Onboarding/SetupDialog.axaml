<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Quartermaster.Gui.Localization" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Onboarding" x:Class="Quartermaster.Gui.Onboarding.SetupDialog"
             x:DataType="vm:SetupViewModel" Width="480">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Progress}" Classes="accent" FontSize="11" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Title}" Classes="pageTitle" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
    <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left" IsVisible="{Binding IsGame}">
        <shared:ContentSizedTextBox x:Name="GameFolderInput" Text="{Binding GamePath, Mode=TwoWay}" PlaceholderText="{loc:Loc 'Helldivers 2 folder'}" />
        <Button Grid.Column="1" Content="{loc:Loc 'Browse'}" Command="{Binding BrowseCommand}" />
      </Grid>
      <CheckBox IsVisible="{Binding IsUpdates}" Content="{loc:Loc 'Allow automatic update checks'}" IsChecked="{Binding AllowAutomaticUpdate, Mode=TwoWay}" />
      <StackPanel IsVisible="{Binding IsNexus}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
          <shared:ContentSizedTextBox x:Name="NexusKeyInput" Text="{Binding NexusApiKey, Mode=TwoWay}" PasswordChar="*" IsEnabled="{Binding !RemoveNexusKey}" PlaceholderText="{loc:Loc 'Personal Nexus API key'}" />
          <Button Grid.Column="1" x:Name="RemoveNexusKeyButton" Content="{Binding RemoveNexusKeyLabel}" Command="{Binding RemoveNexusKeyCommand}" IsVisible="{Binding HasSavedNexusKey}" ToolTip.Tip="{loc:Loc 'Continue to apply removal.'}" />
        </Grid>
        <HyperlinkButton Content="{loc:Loc 'Get your Nexus API key →'}" Command="{Binding OpenNexusCommand}" Foreground="{DynamicResource AccentBrush}" Padding="0" />
      </StackPanel>
      <StackPanel IsVisible="{Binding IsGitHub}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
          <shared:ContentSizedTextBox x:Name="GitHubTokenInput" Text="{Binding GitHubToken, Mode=TwoWay}" PasswordChar="*" IsEnabled="{Binding !RemoveGitHubToken}" PlaceholderText="{loc:Loc 'GitHub personal access token'}" />
          <Button Grid.Column="1" x:Name="RemoveGitHubTokenButton" Content="{Binding RemoveGitHubTokenLabel}" Command="{Binding RemoveGitHubTokenCommand}" IsVisible="{Binding HasSavedGitHubToken}" ToolTip.Tip="{loc:Loc 'Continue to apply removal.'}" />
        </Grid>
        <HyperlinkButton Content="{loc:Loc 'Create a GitHub token →'}" Command="{Binding OpenGitHubCommand}" Foreground="{DynamicResource AccentBrush}" Padding="0" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left" IsVisible="{Binding IsDownloads}">
        <shared:ContentSizedTextBox Text="{Binding DownloadFolder, Mode=TwoWay}" PlaceholderText="{loc:Loc 'Browser download folder'}" />
        <Button Grid.Column="1" Content="{loc:Loc 'Browse'}" Command="{Binding BrowseCommand}" />
      </Grid>
    </StackPanel>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc 'Saving…'}" IsVisible="{Binding IsBusy}" Classes="muted" FontSize="11" />
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <Button x:Name="SkipSetupButton" Content="{loc:Loc 'Skip setup'}" Command="{Binding SkipSetupCommand}" IsVisible="{Binding CanSkipSetup}" HorizontalAlignment="Left" />
      <Button Grid.Column="1" Content="{loc:Loc 'Back'}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
      <Button x:Name="SkipTourButton" Grid.Column="2" Content="{loc:Loc 'Skip tour'}" Command="{Binding SkipCommand}" IsVisible="{Binding IsReady}" />
      <Button x:Name="NextStepButton" Grid.Column="3" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Classes="primary" />
    </Grid>
  </StackPanel>
</UserControl>
