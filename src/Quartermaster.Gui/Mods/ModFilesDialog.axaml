<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Quartermaster.Providers.Providers;assembly=Quartermaster.Providers"
             x:Class="Quartermaster.Gui.Mods.ModFilesDialog" x:DataType="p:ProviderMod" Width="500">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Name}" Classes="pageTitle" TextWrapping="Wrap" />
    <ScrollViewer MaxHeight="180"><TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" /></ScrollViewer>
    <TextBlock Text="Choose the file to add to your library." />
    <ComboBox x:Name="FileChoices" ItemsSource="{Binding Files}" HorizontalAlignment="Stretch" SelectionChanged="FileChanged">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="p:ProviderFile"><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding FileName}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="This opens the file's download page in your browser. Finish the download there; Quartermaster watches your configured download folder, verifies the ZIP, and adds it automatically. You can keep using the app while it waits." Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="CancelInput" />
      <Button x:Name="AcceptButton" Content="Open download page" Classes="primary" Click="AcceptInput" />
    </StackPanel>
  </StackPanel>
</UserControl>
