<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Mods" x:Class="Quartermaster.Gui.Mods.ModOptionsView" x:DataType="vm:ModOptionsViewModel">
  <ItemsControl ItemsSource="{Binding Options}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OptionEdit">
      <StackPanel Spacing="8" Margin="0,0,0,16">
        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}" IsVisible="{Binding HasChoices}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
