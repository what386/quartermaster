<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Mods" x:Class="Quartermaster.Gui.Mods.ModRowView" x:DataType="vm:IModRow">
  <Grid ColumnDefinitions="32,Auto,56,*,Auto" Margin="10,9" MinHeight="46">
    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
    <Button Grid.Column="1" Classes="rowSwitch" Classes.active="{Binding IsEnabled}" Command="{Binding EnableCommand}" IsVisible="{Binding HasToggle}" AutomationProperties.Name="{Binding ToggleDescription}" VerticalAlignment="Center" Margin="8,0,14,0">
      <Grid Width="30"><Ellipse Fill="#111315" Width="14" Height="14" HorizontalAlignment="{Binding KnobAlignment}" /></Grid>
    </Button>
    <Border Grid.Column="2" Classes="modTile" Classes.enabled="{Binding IsEnabled}" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock Text="{Binding Monogram}" FontSize="14" FontWeight="SemiBold" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center" Margin="4,0,12,0">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="10" />
    </StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <Border BorderBrush="{DynamicResource ClashBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2" IsVisible="{Binding HasConflict}"><TextBlock Text="CLASH" Foreground="{DynamicResource ClashBrush}" FontSize="9" /></Border>
      <Path Data="M0,2 L18,2 M0,8 L18,8 M0,14 L18,14" Width="18" Height="16" Stroke="#6F767E" StrokeThickness="1.3" IsVisible="{Binding HasToggle}" ToolTip.Tip="Drag to reorder; right-click for mod actions" />
    </StackPanel>
  </Grid>
</UserControl>
