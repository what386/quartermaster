<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Mods" x:Class="Quartermaster.Gui.Mods.ModPageLinkView" x:DataType="vm:ModDetailsViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="Mod page" FontWeight="SemiBold" />
    <TextBox x:Name="PageLinkInput" Text="{Binding PageLink, Mode=TwoWay}" PlaceholderText="https://…" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Save link" Command="{Binding SavePageCommand}" />
      <Button Content="Open page" Command="{Binding OpenPageCommand}" />
    </StackPanel>
    <TextBlock Text="For mods without provider tracking, set their page here and use Manual checks in Downloads to check for updates." Classes="muted" FontSize="11" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
