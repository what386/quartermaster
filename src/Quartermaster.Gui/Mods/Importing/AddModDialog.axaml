<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared"
             x:Class="Quartermaster.Gui.Mods.AddModDialog" Width="460">
  <StackPanel Spacing="16">
    <TextBlock Text="Add mod" Classes="pageTitle" />
    <TextBlock Text="Paste a mod link, or choose a local ZIP or folder." Classes="muted" TextWrapping="Wrap" />
    <shared:ContentSizedTextBox x:Name="LinkInput" PlaceholderText="Mod link" TextChanged="LinkChanged" />
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Choose ZIP…" Click="ChooseZip" />
      <Button Content="Choose folder…" Click="ChooseFolder" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="CancelInput" />
      <Button x:Name="AcceptButton" Content="Load link" Classes="primary" IsEnabled="False" Click="AcceptInput" />
    </StackPanel>
  </StackPanel>
</UserControl>
