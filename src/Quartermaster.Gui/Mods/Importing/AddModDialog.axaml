<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Quartermaster.Gui.Localization" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared"
             x:Class="Quartermaster.Gui.Mods.AddModDialog" Width="460">
  <StackPanel Spacing="16">
    <TextBlock Text="{loc:Loc 'Add mod'}" Classes="pageTitle" />
    <TextBlock Text="{loc:Loc 'Paste a mod link, or choose a local ZIP or folder.'}" Classes="muted" TextWrapping="Wrap" />
    <shared:ContentSizedTextBox x:Name="LinkInput" PlaceholderText="{loc:Loc 'Mod link'}" TextChanged="LinkChanged" />
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="{loc:Loc 'Choose ZIP…'}" Click="ChooseZip" />
      <Button Content="{loc:Loc 'Choose folder…'}" Click="ChooseFolder" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="{loc:Loc 'Cancel'}" Click="CancelInput" />
      <Button x:Name="AcceptButton" Content="{loc:Loc 'Load link'}" Classes="primary" IsEnabled="False" Click="AcceptInput" />
    </StackPanel>
  </StackPanel>
</UserControl>
