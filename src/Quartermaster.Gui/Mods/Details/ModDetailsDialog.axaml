<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Mods" x:Class="Quartermaster.Gui.Mods.ModDetailsDialog" x:DataType="vm:ModDetailsViewModel" Width="520" Height="540">
  <Grid RowDefinitions="*,Auto">
    <Grid.Resources>
      <DataTemplate x:Key="RelationshipTemplate" x:DataType="vm:ModRelationshipItem">
        <StackPanel Spacing="4" Margin="0,0,0,8">
          <HyperlinkButton Content="{Binding Name}" Command="{Binding OpenPageCommand}" IsVisible="{Binding HasPage}" Padding="0" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasPage}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" Classes="muted" FontSize="11" />
          <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
    </Grid.Resources>
    <ScrollViewer>
      <StackPanel Spacing="18">
        <TextBlock Text="{Binding Name}" Classes="sectionTitle" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
        <vm:ModPageLinkView />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto"><TextBlock Text="Version" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Version}" /><TextBlock Grid.Row="1" Text="Imported" Classes="muted" Margin="0,8,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImportedAt}" Margin="0,8,0,0" /></Grid>
        <TextBlock Text="{Binding ResourceSummary}" TextWrapping="Wrap" />
        <TextBlock Text="This mod has options. Configure them in Profiles." IsVisible="{Binding HasOptions}" Classes="accent" TextWrapping="Wrap" />
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Dependencies" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="ResolveDependenciesButton" Grid.Column="1" Content="Resolve dependencies" Command="{Binding ResolveDependenciesCommand}" IsVisible="{Binding CanResolveDependencies}" />
          </Grid>
          <TextBlock Text="{Binding DependencySummary}" IsVisible="{Binding !HasDependencies}" Classes="muted" />
          <ItemsControl x:Name="DependenciesList" ItemsSource="{Binding Dependencies}" ItemTemplate="{StaticResource RelationshipTemplate}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Dependents" FontWeight="SemiBold" />
          <TextBlock Text="No dependents in your library." IsVisible="{Binding !HasDependents}" Classes="muted" />
          <ItemsControl x:Name="DependentsList" ItemsSource="{Binding Dependents}" ItemTemplate="{StaticResource RelationshipTemplate}" />
        </StackPanel>
        <TextBlock Text="Archives" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Archives}" />
        <TextBlock Text="Patch files" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="Close" Click="CloseDialog" HorizontalAlignment="Right" Margin="0,16,0,0" />
  </Grid>
</UserControl>
