<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Mods" x:Class="Quartermaster.Gui.Mods.ModsView" x:DataType="vm:ModsViewModel">
  <Grid Background="Transparent" RowDefinitions="Auto,Auto,*" IsEnabled="{Binding !Operations.IsProgressVisible}" IsHitTestVisible="{Binding Operations.CanInteract}">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Text="Library" Classes="pageTitle" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBox Grid.Column="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search names in your mod library…" />
      <Button Grid.Column="2" x:Name="AddModButton" Content="Add mod" Classes="primary" Command="{Binding AddModCommand}" Margin="8,0" />
      <Button Grid.Column="3" Content="Check updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
    </Grid>
    <Border Grid.Row="1" Classes="groupHeader" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="LibraryHeader" Text="{Binding LibraryHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="UpdateAllButton" Content="Update all" Command="{Binding UpdateAllCommand}" IsVisible="{Binding HasUpdates}"
                Background="Transparent" Foreground="{DynamicResource AccentForegroundBrush}" MinHeight="0" Padding="8,1" FontSize="11" />
      </Grid>
    </Border>
    <Grid Grid.Row="2" RowDefinitions="24,*">
      <Border Background="{DynamicResource TableHeaderBackground}" Padding="12,3"><Grid ColumnDefinitions="32,*"><TextBlock Text="#" Classes="muted" FontSize="11" /><TextBlock Grid.Column="1" Text="Mod" Classes="muted" FontSize="11" Margin="56,0,0,0" /></Grid></Border>
      <ListBox Grid.Row="1" x:Name="ModsList" AutoScrollToSelectedItem="False" Focusable="True" Classes="modList" SelectionMode="Multiple" ItemsSource="{Binding Mods}" SelectedItems="{Binding SelectedMods}" DoubleTapped="OpenModDetails">
        <ListBox.ContextMenu><ContextMenu>
          <MenuItem x:Name="AddToProfileMenuItem" Header="Add to" IsEnabled="{Binding HasSelection}" />
          <MenuItem Header="Remove from library" Command="{Binding RemoveCommand}" />
          <Separator />
          <MenuItem Header="Export repatched ZIP" Command="{Binding ExportRepatchedCommand}" />
          <MenuItem Header="Mod details" IsEnabled="{Binding HasSingleSelection}" Click="OpenModDetails" />
          <MenuItem Header="{Binding DependencyActionLabel}" IsVisible="{Binding HasDependencyAction}" Command="{Binding GetDependenciesCommand}" />
        </ContextMenu></ListBox.ContextMenu>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ModListItem"><vm:ModRowView /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding !HasVisibleMods}" Classes="muted" HorizontalAlignment="Center" Margin="16" />
    </Grid>
  </Grid>
</UserControl>
