<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Quartermaster.Gui.Services" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared" x:Class="Quartermaster.Gui.Mods.DownloadQueueView" x:DataType="services:ModDownloads" Width="680">
  <StackPanel Spacing="12">
    <TextBlock Text="Downloads" Classes="sectionTitle" />
    <TextBlock Text="For browser downloads, finish downloading on the provider's page. Quartermaster watches your configured download folder and imports each verified ZIP automatically." Classes="muted" TextWrapping="Wrap" />
    <ScrollViewer MaxHeight="420">
      <ItemsControl ItemsSource="{Binding Jobs}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="services:DownloadRow">
          <Border Classes="card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
              <shared:BusySpinner IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
              <Button Grid.Column="2" Content="Open download page" Command="{Binding OpenCommand}" />
              <Button Grid.Column="3" Content="Retry" Command="{Binding RetryCommand}" />
              <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelCommand}" />
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
