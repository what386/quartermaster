<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Settings" x:Class="Quartermaster.Gui.Settings.GitHubSettingsView" x:DataType="vm:SettingsViewModel">
  <Grid ColumnDefinitions="180,*">
    <StackPanel Spacing="4"><TextBlock Text="GitHub" FontWeight="SemiBold" /><TextBlock Text="{Binding GitHubAccount}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0" /></StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <TextBox x:Name="GitHubTokenInput" Text="{Binding GitHubToken}" PasswordChar="●" IsEnabled="{Binding !RemoveGitHubToken}" PlaceholderText="Optional personal access token" MinWidth="260" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" x:Name="RemoveGitHubTokenInput" Content="Remove saved token" IsChecked="{Binding RemoveGitHubToken, Mode=TwoWay}" IsEnabled="{Binding HasSavedGitHubToken}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="A token increases your GitHub API rate limit. Create one in GitHub Settings → Developer settings → Personal access tokens, you do not need any extra permissions beyond read-only." Classes="muted" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
