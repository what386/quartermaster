<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Settings" x:Class="Quartermaster.Gui.Settings.GitHubSettingsView" x:DataType="vm:SettingsViewModel">
  <Grid ColumnDefinitions="180,*">
    <StackPanel Spacing="4"><TextBlock Text="GitHub" FontWeight="SemiBold" /><TextBlock Text="{Binding GitHubAccount}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0" /></StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <TextBox x:Name="GitHubTokenInput" Text="{Binding GitHubToken}" PasswordChar="●" IsEnabled="{Binding !RemoveGitHubToken}" PlaceholderText="Optional personal access token, then Save" />
      <CheckBox Content="Remove saved token" IsChecked="{Binding RemoveGitHubToken}" IsVisible="{Binding HasSavedGitHubToken}" />
      <TextBlock Text="A token increases your GitHub API rate limit. Create one in GitHub Settings → Developer settings → Personal access tokens. The saved token is kept separately from profile exports; public downloads work without it." Classes="muted" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
