<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Settings" x:Class="Quartermaster.Gui.Settings.AppearanceSettingsView" x:DataType="vm:SettingsViewModel">
  <Grid ColumnDefinitions="180,*">
    <StackPanel Spacing="4"><TextBlock Text="Appearance" FontWeight="SemiBold" /><TextBlock Text="Preview changes before saving" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0" /></StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <ComboBox x:Name="ThemeSelector" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeChoice, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Accent color" VerticalAlignment="Center" />
        <ColorPicker x:Name="AccentPicker" Color="{Binding AccentColor, Mode=TwoWay}" IsAlphaEnabled="False" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
