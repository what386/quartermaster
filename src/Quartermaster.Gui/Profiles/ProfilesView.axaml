<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Profiles" xmlns:mods="clr-namespace:Quartermaster.Gui.Mods"
             xmlns:model="clr-namespace:Quartermaster.Library.Mods;assembly=Quartermaster.Library"
             x:Class="Quartermaster.Gui.Profiles.ProfilesView" x:DataType="vm:ProfilesViewModel">
  <Grid Background="Transparent" RowDefinitions="Auto,Auto,*" IsEnabled="{Binding Operations.CanInteract}">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBlock x:Name="ProfileTitle" Text="{Binding SelectedProfile.Name}" Classes="pageTitle" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedProfile.Name}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBox Grid.Column="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search mods in this profile…" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="Add mod" IsEnabled="{Binding HasProfile}" Margin="0,0,8,0">
        <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Spacing="10" Width="320">
          <TextBlock Text="Add a library mod to this profile" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding AvailableMods}" SelectedItem="{Binding ModToAdd, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Choose a library mod">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="model:Mod"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Add to profile" Command="{Binding AddCommand}" Classes="primary" />
        </StackPanel></Flyout></Button.Flyout>
      </Button>
      <Button Grid.Column="3" Content="Purge" Classes="danger" Command="{Binding PurgeCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="4" x:Name="DeployButton" Content="Deploy" Classes="primary" Command="{Binding DeployCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="5" Content="▶  Run" Command="{Binding RunCommand}" />
    </Grid>
    <Border Grid.Row="1" Classes="groupHeader" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="LOADOUT" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding EntrySummary}" /></Grid>
    </Border>
    <Grid Grid.Row="2" RowDefinitions="24,*">
      <Border Background="#25282C" Padding="12,3"><Grid ColumnDefinitions="32,*"><TextBlock Text="#" Classes="muted" FontSize="11" /><TextBlock Grid.Column="1" Text="Mod" Classes="muted" FontSize="11" Margin="106,0,0,0" /></Grid></Border>
      <ListBox Grid.Row="1" x:Name="ProfileModsList" Classes="modList" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}" DoubleTapped="OpenModDetails">
        <ListBox.ContextMenu><ContextMenu>
          <MenuItem x:Name="ModDetailsMenuItem" Header="Mod details" IsEnabled="{Binding HasSelectedMod}" Click="OpenModDetails" />
          <MenuItem Header="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
          <Separator />
          <MenuItem Header="Remove from profile" Command="{Binding RemoveCommand}" />
        </ContextMenu></ListBox.ContextMenu>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileModItem"><mods:ModRowView OptionsRequested="OpenModOptions" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
