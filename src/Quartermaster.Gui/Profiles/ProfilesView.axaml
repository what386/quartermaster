<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Quartermaster.Gui.Profiles" xmlns:mods="clr-namespace:Quartermaster.Gui.Mods"
             xmlns:model="clr-namespace:Quartermaster.Library.Mods;assembly=Quartermaster.Library"
             x:Class="Quartermaster.Gui.Profiles.ProfilesView" x:DataType="vm:ProfilesViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" IsEnabled="{Binding Operations.CanInteract}">
    <TextBlock Text="{Binding SelectedProfile.Name}" Classes="pageTitle" Margin="0,0,0,12" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBox Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search mods in this profile…" Margin="0,0,8,0" />
      <Button Grid.Column="1" Content="Add mod" IsEnabled="{Binding HasProfile}" Margin="0,0,8,0">
        <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Spacing="10" Width="320">
          <TextBlock Text="Add a library mod to this profile" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding AvailableMods}" SelectedItem="{Binding ModToAdd, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Choose a library mod">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="model:Mod"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Add to profile" Command="{Binding AddCommand}" Classes="primary" />
        </StackPanel></Flyout></Button.Flyout>
      </Button>
      <Button Grid.Column="2" x:Name="DeployButton" Content="Deploy" Classes="primary" Command="{Binding DeployCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Content="▶  Run" Command="{Binding RunCommand}" />
    </Grid>
    <Border Grid.Row="2" Classes="groupHeader" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="LOADOUT" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding EntrySummary}" /></Grid>
    </Border>
    <Grid Grid.Row="3" RowDefinitions="24,*">
      <Border Background="#25282C" Padding="12,3"><Grid ColumnDefinitions="32,*"><TextBlock Text="#" Classes="muted" FontSize="11" /><TextBlock Grid.Column="1" Text="Mod" Classes="muted" FontSize="11" Margin="106,0,0,0" /></Grid></Border>
      <ListBox Grid.Row="1" x:Name="ProfileModsList" Classes="modList" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}" DoubleTapped="OpenModDetails">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileModItem"><mods:ModRowView /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10">
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ModDetailsButton" Content="Mod details" IsEnabled="{Binding HasSelectedMod}" Click="OpenModDetails" /><Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" /><Button Content="Move up" Command="{Binding MoveUpCommand}" /><Button Content="Move down" Command="{Binding MoveDownCommand}" /><Button Content="Remove from profile" Command="{Binding RemoveCommand}" /></StackPanel>
      <Button Grid.Column="1" Content="Purge patches" Classes="danger" Command="{Binding PurgeCommand}" />
    </Grid>
    <CheckBox Grid.Row="5" Content="Repair patches against the installed game before deploying" IsChecked="{Binding Repair, Mode=TwoWay}" />
  </Grid>
</UserControl>
