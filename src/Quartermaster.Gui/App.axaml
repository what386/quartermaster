<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quartermaster.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#F27A22" RegionColor="#191B1E" ChromeLow="#101214" ChromeMedium="#23262A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Quartermaster.Gui/Style.axaml" />
  </Application.Styles>
</Application>
