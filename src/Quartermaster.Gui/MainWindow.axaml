<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Quartermaster.Gui.Localization"
        xmlns:local="clr-namespace:Quartermaster.Gui" xmlns:shared="clr-namespace:Quartermaster.Gui.Shared"
        xmlns:mods="clr-namespace:Quartermaster.Gui.Mods" xmlns:profiles="clr-namespace:Quartermaster.Gui.Profiles"
        xmlns:search="clr-namespace:Quartermaster.Gui.Search" xmlns:settings="clr-namespace:Quartermaster.Gui.Settings"
        xmlns:downloads="clr-namespace:Quartermaster.Gui.Downloads" xmlns:services="clr-namespace:Quartermaster.Gui.Services"
        xmlns:onboarding="clr-namespace:Quartermaster.Gui.Onboarding"
        x:Class="Quartermaster.Gui.MainWindow" x:DataType="local:MainWindowViewModel"
        Title="Quartermaster" Width="1320" Height="850" MinWidth="1040" MinHeight="680">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type mods:ModsViewModel}"><mods:ModsView /></DataTemplate>
    <DataTemplate DataType="{x:Type profiles:ProfilesViewModel}"><profiles:ProfilesView /></DataTemplate>
    <DataTemplate DataType="{x:Type search:SearchViewModel}"><search:SearchView /></DataTemplate>
    <DataTemplate DataType="{x:Type services:ModDownloads}"><downloads:DownloadsView /></DataTemplate>
    <DataTemplate DataType="{x:Type downloads:ManualChecksPageViewModel}" x:DataType="downloads:ManualChecksPageViewModel"><downloads:ManualChecksView DataContext="{Binding Downloads}" /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}"><settings:SettingsView /></DataTemplate>
  </Window.DataTemplates>
  <Grid>
    <Grid x:Name="ShellContent" ColumnDefinitions="72,*" IsEnabled="{Binding !IsOpen, ElementName=DialogOverlay}">
      <Border x:Name="Sidebar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="70,1,*,Auto">
          <ContentControl Content="{Binding LibraryNavigation}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <ContentControl.ContentTemplate><DataTemplate x:DataType="local:NavigationItem">
              <Button x:Name="LibraryButton" Classes="profileButton" Classes.active="{Binding IsActive}" Classes.tourTarget="{Binding IsTourTarget}" Command="{Binding OpenCommand}" ToolTip.Tip="{loc:Loc 'Library'}" AutomationProperties.Name="{loc:Loc 'Library'}">
                <shared:SvgIcon Source="{Binding IconSource}" Width="26" Height="26" Foreground="{Binding $parent[Button].Foreground}" />
              </Button>
            </DataTemplate></ContentControl.ContentTemplate>
          </ContentControl>
          <Border Grid.Row="1" Background="{DynamicResource LineBrush}" Margin="12,0" />
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,12">
              <ItemsControl x:Name="ProfileList" ItemsSource="{Binding SidebarProfiles}" IsEnabled="{Binding !Operations.IsProgressVisible}" IsHitTestVisible="{Binding Operations.CanInteract}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SidebarProfile">
                  <Button Classes="profileButton" Classes.active="{Binding IsActive}" Classes.deployed="{Binding IsDeployed}" Command="{Binding SelectCommand}" DoubleTapped="DeployProfile" ToolTip.Tip="{Binding Summary}" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center">
                    <Border CornerRadius="11" ClipToBounds="True" Width="42" Height="42">
                      <Grid>
                        <TextBlock x:Name="ProfileMonogram" Text="{Binding Monogram}" IsVisible="{Binding !IsVisible, ElementName=ProfileThumbnail}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <shared:ProfileThumbnailImage x:Name="ProfileThumbnail" Thumbnail="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <Button.ContextMenu><ContextMenu>
                      <MenuItem Header="{loc:Loc 'Rename'}" Command="{Binding RenameCommand}" />
                      <MenuItem Header="{loc:Loc 'Duplicate profile'}" Command="{Binding DuplicateCommand}" />
                      <MenuItem Header="{loc:Loc 'Change thumbnail'}" Command="{Binding ChangeThumbnailCommand}" />
                      <MenuItem Header="{loc:Loc 'Remove thumbnail'}" Command="{Binding RemoveThumbnailCommand}" IsVisible="{Binding HasThumbnail}" />
                      <MenuItem Header="{loc:Loc 'Delete'}" Command="{Binding DeleteCommand}" />
                      <Separator />
                      <MenuItem Header="{loc:Loc 'Export profile ZIP'}" Command="{Binding ExportCommand}" />
                    </ContextMenu></Button.ContextMenu>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="AddProfileButton" Classes="profileButton" Classes.tourTarget="{Binding Onboarding.IsProfileStep}" Content="+" Command="{Binding AddProfileCommand}" ToolTip.Tip="{loc:Loc 'Create a profile · Right-click to import'}" AutomationProperties.Name="{loc:Loc 'Create a profile'}" FontSize="23" HorizontalAlignment="Center">
                <Button.ContextMenu><ContextMenu>
                  <MenuItem Header="{loc:Loc 'Import profile ZIP'}" Command="{Binding ImportProfileCommand}" />
                </ContextMenu></Button.ContextMenu>
              </Button>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,12">
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="12,0,12,12" />
            <ItemsControl ItemsSource="{Binding UtilityNavigationItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:NavigationItem">
                <Button Classes="profileButton" Classes.active="{Binding IsActive}" Classes.tourTarget="{Binding IsTourTarget}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}" HorizontalAlignment="Center">
                  <shared:SvgIcon Source="{Binding IconSource}" Width="24" Height="24" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Padding="12" ClipToBounds="True">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>
    <Canvas x:Name="OnboardingLayer" IsVisible="{Binding Onboarding.IsTourVisible}">
      <Polygon x:Name="OnboardingPointer" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
      <onboarding:TourView x:Name="OnboardingTour" DataContext="{Binding Onboarding}" />
    </Canvas>
    <shared:DialogHost x:Name="DialogOverlay" />
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="620" Spacing="8">
    <shared:ErrorNotification x:Name="ErrorOverlay" DataContext="{Binding Operations}" />
    <Border x:Name="DownloadProgressOverlay" IsVisible="{Binding ShowDownloadProgress}"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <shared:BusySpinner IsVisible="{Binding ShowDownloadProgress}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Downloads.PendingSummary}" FontWeight="SemiBold" /><TextBlock Text="{Binding Downloads.PendingExplanation}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
      </Grid>
    </Border>
    <Border x:Name="ProgressOverlay" IsVisible="{Binding Operations.IsProgressVisible}" MinWidth="360"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Operations.Message}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="90" Height="3" VerticalAlignment="Center" Margin="16,0" />
        <Button Grid.Column="2" Content="{loc:Loc 'Cancel'}" Command="{Binding Operations.CancelCommand}" />
      </Grid>
    </Border>
    </StackPanel>
  </Grid>
</Window>
