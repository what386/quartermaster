<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quartermaster.Gui.Shared.DialogHost" KeyboardNavigation.TabNavigation="Cycle">
  <Border Background="#A6000000">
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="24" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentControl x:Name="DialogContent" />
    </Border>
  </Border>
</UserControl>
