<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quartermaster.Gui.Shared.ConfirmationDialog" Width="420">
  <StackPanel Spacing="20">
    <TextBlock x:Name="TitleText" Classes="pageTitle" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelConfirmation" />
      <Button x:Name="AcceptButton" Classes="primary" Click="AcceptConfirmation" />
    </StackPanel>
  </StackPanel>
</UserControl>
