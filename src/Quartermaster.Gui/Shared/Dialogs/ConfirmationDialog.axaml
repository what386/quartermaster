<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Quartermaster.Gui.Localization"
             x:Class="Quartermaster.Gui.Shared.ConfirmationDialog" Width="420">
  <StackPanel Spacing="20" Margin="20">
    <TextBlock x:Name="TitleText" Classes="pageTitle" TextWrapping="Wrap" />
    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="{loc:Loc 'Cancel'}" Click="CancelConfirmation" />
      <Button x:Name="AcceptButton" Classes="primary" Click="AcceptConfirmation" />
    </StackPanel>
  </StackPanel>
</UserControl>
