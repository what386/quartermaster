<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Pin until Avalonia.Headless.XUnit supports xUnit 4's discovery APIs. -->
    <PackageReference Include="xunit.v3" Version="[3.2.2]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <ProjectReference Include="../../src/Quartermaster.Gui/Quartermaster.Gui.csproj" />
  </ItemGroup>
</Project>
